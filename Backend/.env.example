# This file configures local development only. Production values are set in the
# hosting platform's dashboard (see render.yaml and the Deployment section of
# the README) — nothing here is deployed.
NODE_ENV=development
PORT=3100
FRONTEND_URL=http://localhost:3101

# Deliberately a local database, even once a cloud one exists. Pointing this at
# the production cluster would mean every order placed while developing lands
# in real data and decrements real stock.
MONGODB_URI=mongodb://localhost:27017/restaurant-ordering

# Must be at least 32 characters — generate one with `openssl rand -base64 48`
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Email — two transports, whichever is configured. Brevo wins if both are.
#
# Brevo (use this in production). An ordinary HTTPS request, so hosts that
# block outbound SMTP can't block it — Render's free instances refuse traffic
# on ports 25/465/587, which makes SMTP work locally and silently do nothing
# once deployed. Verify a single sender address in Brevo; a whole domain is not
# required, so this works before you own one.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=your_verified_sender@gmail.com
MAIL_FROM_NAME=Fire House

# Prefix on human-readable order numbers, e.g. FH-20260909-0001.
# 2-6 letters or digits. Defaults to FH.
ORDER_NUMBER_PREFIX=FH

# Gmail over SMTP — convenient locally, where nothing is blocked.
# Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_16_characters

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3100/auth/google/callback

# OTP Configuration
OTP_EXPIRATION_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# Paymob Configuration
# Card checkout is disabled unless all four are set.
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_paymob_integration_id
PAYMOB_IFRAME_ID=your_paymob_iframe_id
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret

# --- WhatsApp order alerts (Meta Cloud API) ---
#
# When a customer places an order the team gets a WhatsApp message with the
# order number, the customer's name and phone, the total, and a link that
# opens the order in the dashboard.
#
# Leave these blank and everything still works: orders appear in the dashboard
# immediately, and each alert is recorded under Admin -> Alerts with its full
# text, marked "Not sent". Fill them in and the same alerts start sending.
#
# Numbers that receive the alerts. Staff/owner mobiles, comma-separated. Meta
# sends to individual people, NOT to a WhatsApp group. Local (01…) or
# international (+20…) both work.
WHATSAPP_RECIPIENTS=

# From the Meta app dashboard -> WhatsApp -> API Setup.
# The temporary token there lasts 24 hours; generate a permanent System User
# token before going live.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# The name of your approved message template, and its language code.
# REQUIRED IN PRODUCTION: WhatsApp only delivers free-form text within 24 hours
# of the recipient messaging your business number, so an alert at 9pm to a
# staff member who has not messaged you today silently will not arrive.
# Leave blank only while testing.
#
# Create it under WhatsApp Manager -> Message templates, category "Utility",
# with exactly five body variables in this order:
#   {{1}} order number      {{2}} customer name and phone
#   {{3}} item count and total                {{4}} payment method and status
#   {{5}} link to the order in the dashboard
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Any random string. You type the same value into Meta's webhook setup so it
# can prove the callback is really from them. Only needed if you want delivery
# receipts ("sent / delivered / read") shown on the Alerts screen.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
